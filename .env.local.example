# Database
DATABASE_URL=

# QuickBooks Online OAuth
QBO_CLIENT_ID=
QBO_CLIENT_SECRET=
QBO_REDIRECT_URI=https://stb-project-health-codex-pena.loca.lt/api/qbo/callback
QBO_ENVIRONMENT=production

# AI provider
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.2

# Plaid bank feed. Read-only: balances and transactions only. Do not rename these.
# PLAID_ENV is sandbox, development, or production.
# PLAID_REDIRECT_URI is the Bank Feed page registered in the Plaid dashboard,
# for example https://<render-host>/bank-feed
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox
PLAID_REDIRECT_URI=

# App
NEXT_PUBLIC_APP_URL=https://stb-project-health-codex-pena.loca.lt
# Encrypts stored Plaid and QuickBooks tokens. Required before a bank can be connected.
TOKEN_ENCRYPTION_KEY=
# Bearer token for /api/ai-csuite/finance-export.
# A Team-page read-only key (stb_ro_...) is also accepted there and on GET /api/plaid/accounts.
# Send Authorization: Bearer <token>. Optional export query: ?refresh=plaid
AI_CSUITE_EXPORT_TOKEN=

# Sign-in
# One-time code used to create the first admin account at /setup-owner.
OWNER_SETUP_CODE=
# Optional: lets a scheduled job call the /api/*/sync routes with "Authorization: Bearer <CRON_SECRET>".
CRON_SECRET=
